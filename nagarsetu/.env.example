# NagarSetu Serverpod Backend Environment Configuration
SERVERPOD_PORT=8080
SERVERPOD_PUBLIC_SCHEME=http
SERVERPOD_PUBLIC_HOST=localhost
SERVERPOD_PUBLIC_PORT=8080

# PostgreSQL + PostGIS Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nagarsetu
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis Cache (Optional - fallback to memory cache if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python AI Microservice (Vision, YOLO, Image Hash, Multilingual NLP)
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1
AI_SERVICE_TIMEOUT_SECONDS=10

# Security & Secrets
SERVERPOD_SERVICE_SECRET=your_super_secret_serverpod_key_here
BCRYPT_ROUNDS=12
STORAGE_UPLOAD_DIR=storage/uploads
